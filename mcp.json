{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dataiku": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--locked",
        "--script",
        "${CURSOR_PLUGIN_ROOT}/runtime/run_mcp.py",
        "--transport",
        "stdio"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}"
    }
  }
}
