# syntax=docker/dockerfile:1.7
# bench-mcp: the dataiku MCP server, run as an isolated HTTP sidecar.
#
# This container is the ONLY place DSS creds live for MCP profiles. The agent
# container never receives DATAIKU_URL/DATAIKU_API_KEY and never has the MCP
# source on disk — it connects to this sidecar over streamable-http with a URL
# only. DSS creds are injected at `docker run` time by the runner, never baked.
#
# Built from the same staged context as the agent image (benchmark/docker/build.sh):
# the agent-dev-kit/ dir holds the dataiku_mcp package + a generated pyproject.
#
# Build with benchmark/docker/build.sh.

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# uv (for `uv run python -m dataiku_mcp`).
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Non-root user; owns the server source. The agent never shares this container,
# so ownership here is purely good hygiene.
ARG MCP_UID=1000
ARG MCP_GID=1000
RUN groupadd -g ${MCP_GID} mcp \
    && useradd -m -u ${MCP_UID} -g ${MCP_GID} -s /bin/bash mcp \
    && mkdir -p /opt/mcp && chown -R mcp:mcp /opt/mcp

USER mcp
COPY --chown=mcp:mcp agent-dev-kit /opt/mcp/agent-dev-kit
RUN cd /opt/mcp/agent-dev-kit && uv sync

# streamable-http transport bound to all interfaces so the agent container can
# reach it across the per-run docker network. Host/port resolve from these env
# vars via FastMCP Settings (env_prefix FASTMCP_); verified on fastmcp 3.3.x.
# DSS creds (DATAIKU_URL / DATAIKU_API_KEY) are NOT set here — the runner passes
# them with `docker run -e` so they never appear in this image.
ENV DATAIKU_MCP_TRANSPORT=streamable-http \
    FASTMCP_HOST=0.0.0.0 \
    FASTMCP_PORT=8000 \
    DATAIKU_MAX_WORKERS=16

EXPOSE 8000
WORKDIR /opt/mcp/agent-dev-kit

# Liveness: the streamable-http endpoint serves at /mcp. A plain GET returns a
# non-2xx (MCP expects negotiated POST), so we only assert the socket answers —
# curl without -f exits 0 on any HTTP response, which proves the server is up.
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -s -o /dev/null --max-time 3 "http://localhost:${FASTMCP_PORT}/mcp" || exit 1

CMD ["uv", "run", "python", "-m", "dataiku_mcp"]
