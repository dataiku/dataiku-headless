# Copy this file to .env and fill in values for local development.

# Environment-configured DSS instance. It takes precedence over the
# `default_instance` selected by config.json.
DKU_INSTANCE_NAME="dev-dss"
DKU_DSS_URL=https://your-instance.dataiku.com
DKU_NO_CHECK_CERTIFICATE=false # true/1/yes skips TLS certificate verification
DKU_API_KEY=your-api-key

# Optional: directory containing config.json and/or .env. When unset, config
# falls back to ./.dataiku/config.json and then the XDG user config directory.
# DKU_CONFIG_DIR=/absolute/path/to/config

# MCP Server Configuration
# The server is stdio-only with one fixed tool catalog — there is no transport,
# tool-exposure, or Cobuild "mode" to configure.
DKU_MCP_MAX_WORKERS=4
