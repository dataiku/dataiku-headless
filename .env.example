# Copy this file to .env and fill in values for local development.

# --- Connection (required) ---
# The DSS instance to talk to. DKU_DSS_URL being set is what marks an instance as
# configured; this env instance takes precedence over any `default_instance` in
# .dataiku/config.json.
DKU_INSTANCE_NAME="dev-dss"
DKU_DSS_URL=https://your-instance.dataiku.com
DKU_API_KEY=your-api-key
DKU_NO_CHECK_CERTIFICATE=false   # true/1 skips SSL verification (matches Dataiku's local config)

# --- Optional defaults (fed to Cobuild prompts / upload tools when omitted) ---
DKU_DEFAULT_CONNECTION=filesystem_managed
DKU_DEFAULT_FOLDER_CONNECTION=filesystem_folders
DKU_DEFAULT_LLM=openai:<YOUR_CONNECTION_NAME>:gpt-5.4
DKU_DEFAULT_EMBEDDING_LLM=openai:<YOUR_CONNECTION_NAME>:text-embedding-3-small

# --- MCP server ---
DKU_MCP_MAX_WORKERS=4            # thread-pool size for blocking DSS API calls
DKU_MCP_TRANSPORT=stdio          # stdio | streamable-http (gates the transport-specific tools)
# Durable Cobuild conversation registry (survives server restarts).
# Defaults to ~/.local/state/dataiku-headless when unset.
DKU_MCP_STATE_DIR=

# --- Optional streamable-http settings ---
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
