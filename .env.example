# Copy this file to .env and fill in values for local development.

# Optional automation/development override. Interactive plugin users should run
# the configure_dataiku tool instead. When set, this instance takes precendece over 
# the `default_instance` defined in .dataiku/config.json
DKU_INSTANCE_NAME="dev-dss"
DKU_DSS_URL=https://your-instance.dataiku.com
DKU_NO_CHECK_CERTIFICATE=false # Set to true/1 to skip SSL verification
DKU_API_KEY=your-api-key

# Optional: point at a specific config file instead of ~/.dataiku/config.json.
# DKU_CONFIG_FILE=/path/to/config.json

# MCP Server Configuration
DKU_MCP_MAX_WORKERS=4
