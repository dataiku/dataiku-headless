# Copy this file to .env and fill in values for local development.

# --- Connection (required) ---
# The DSS instance to talk to. DKU_DSS_URL being set is what marks an instance as
# configured; this env instance takes precedence over any `default_instance` in
# .dataiku/config.json.
DKU_INSTANCE_NAME="dev-dss"
DKU_DSS_URL=https://your-instance.dataiku.com
DKU_API_KEY=your-api-key
DKU_NO_CHECK_CERTIFICATE=false   # true/1/yes skips SSL verification; false/0/no (or empty) enforces it; other values rejected

# --- MCP server ---
DKU_MCP_MAX_WORKERS=4            # thread-pool size for blocking DSS API calls
DKU_MCP_TRANSPORT=stdio          # stdio | streamable-http (gates the transport-specific tools)
DKU_MCP_MAX_COBUILD_TURNS=8      # cap on retained Cobuild turns (in-flight + recently settled)
# Durable Cobuild conversation registry (conversations + observed confirmation ids survive restarts).
# Defaults to ~/.local/state/dataiku-headless when unset.
DKU_MCP_STATE_DIR=

# --- Instance config file location (optional) ---
# Instance definitions live in a config.json, resolved in this order (first match wins):
#   $DKU_CONFIG_DIR/config.json  ->  ./.dataiku/config.json  ->  ~/.config/dataiku-headless/config.json
DKU_CONFIG_DIR=

# --- Optional streamable-http settings ---
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
