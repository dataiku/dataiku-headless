# Copy this file to .env and fill in values for local development.

# Optional automation/development override. Interactive plugin users should run
# the configure_instance tool instead. When set, this instance takes precedence
# over the resolved config file's `default_instance`.
DKU_INSTANCE_TYPE=design # design, automation, deployer, govern, or agent-management
DKU_DSS_URL=https://your-instance.dataiku.com
DKU_API_KEY=your-api-key
DKU_INSTANCE_NAME="dev-dataiku" # (optional, default 'dataiku-from-env')
DKU_NO_CHECK_CERTIFICATE=false # (optional, default false) set to true/1 to skip SSL verification

# MCP Server Configuration
DKU_MCP_MAX_WORKERS=4
