# Dataiku Headless — environment configuration
#
# Copy to `.env` and fill in your values, or export these in your shell.
# Most users only need DKU_URL + DKU_API_KEY. For interactive setup that stores
# the key in your OS keychain instead of a file, run `dku auth login`.

# --- Connection (required) ---------------------------------------------------
# Your Dataiku DSS instance URL, e.g. https://dss.example.com
DKU_URL=

# A DSS API key. Create one in DSS → Profile & settings → API keys.
# Every dku command runs as you, with your DSS permissions and audit trail.
DKU_API_KEY=

# --- Convenience defaults (optional) -----------------------------------------
# Default project key so you can omit -P on most commands.
# DKU_PROJECT=

# Named auth profile to select when you keep several DSS instances.
# DKU_PROFILE=

# Default output format for list/object commands: tsv | json | csv | ids | quiet
# DKU_FORMAT=

# --- Advanced (optional) -----------------------------------------------------
# Set to 1 to skip destructive-op confirmations for a session. Tier-4 ADMIN
# operations are never bypassable. Leave unset unless you know you want this.
# DKU_DANGEROUS=

# Override where the MCP server keeps per-session state (defaults to a per-user
# directory under the system temp dir).
# DKU_MCP_STATE_ROOT=
