{
  "name": "dataiku-headless",
  "displayName": "Dataiku Headless",
  "version": "0.2.0",
  "description": "Connect your agent to Dataiku DSS: inspect projects, datasets, recipes, ML, and agents with typed MCP tools, and drive Dataiku Cobuild to build project-level assets.",
  "author": {
    "name": "Dataiku",
    "url": "https://www.dataiku.com/"
  },
  "homepage": "https://github.com/dataiku/dataiku-headless",
  "repository": "https://github.com/dataiku/dataiku-headless",
  "license": "Apache-2.0",
  "keywords": ["dataiku", "dss", "cobuild"],
  "mcpServers": {
    "dataiku": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@manzt/uv@0.8.13",
        "run",
        "--quiet",
        "${CLAUDE_PLUGIN_ROOT}/bin/run_mcp.py"
      ],
      "env": {
        "UV_CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/uv-cache",
        "DKU_INSTANCE_NAME": "${DKU_INSTANCE_NAME:-}",
        "DKU_DSS_URL": "${DKU_DSS_URL:-}",
        "DKU_API_KEY": "${DKU_API_KEY:-}",
        "DKU_NO_CHECK_CERTIFICATE": "${DKU_NO_CHECK_CERTIFICATE:-}",
        "DKU_CONFIG_FILE": "${DKU_CONFIG_FILE:-}"
      }
    }
  }
}
