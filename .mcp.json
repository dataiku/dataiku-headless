{
  "mcpServers": {
    "dataiku": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        "./bin/run_mcp.py"
      ],
      "cwd": ".",
      "env": {
        "DKU_MCP_TRANSPORT": "stdio"
      },
      "env_vars": [
        "DKU_INSTANCE_NAME",
        "DKU_DSS_URL",
        "DKU_API_KEY",
        "DKU_NO_CHECK_CERTIFICATE",
        "DKU_CONFIG_FILE"
      ]
    }
  }
}
