{
  "mcpServers": {
    "dataiku": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--locked",
        "--script",
        "./runtime/run_mcp.py",
        "--transport",
        "stdio"
      ],
      "cwd": ".",
      "env_vars": [
        "DKU_INSTANCE_NAME",
        "DKU_DSS_URL",
        "DKU_API_KEY",
        "DKU_NO_CHECK_CERTIFICATE",
        "DKU_IS_CODE_STUDIO",
        "DKU_BACKEND_PROTOCOL",
        "DKU_BACKEND_HOST",
        "DKU_BACKEND_PORT",
        "DKU_API_TICKET"
      ]
    }
  }
}
